# FlaVR Bot settings. In Portainer paste these under the stack's "Environment variables"
# (Advanced mode takes this whole file). For a plain `docker compose up`, copy to .env.
# Keep in sync with flavrbot/config.py.

# ── Discord (required) ──
# Bot token: discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Your own Discord user id (Settings → Advanced → Developer Mode, then right-click your name → Copy User ID)
OWNER_ID=
# Your server's id (right-click the server icon → Copy Server ID): commands show up at once
GUILD_ID=

# ── Stream Core link (required for pings, /points, /queue) ──
# Any long password; type the same one in Stream Core: Setup → Discord & video requests → Companion bot
FLAVR_CORE_KEY=
# Port Stream Core sends to (Core's address box: http://<this PC's address>:3870)
LISTEN_PORT=3870

# ── /wake (optional) ──
# The stream PC's network card MAC, like AA:BB:CC:DD:EE:FF (docs/WAKE_ON_LAN.md)
STREAM_PC_MAC=
WOL_BROADCAST=255.255.255.255

# ── Go-live watcher (each platform optional; leave empty to skip it) ──
# dev.twitch.tv → Your Console → Register Your Application (OAuth Redirect http://localhost, Confidential)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# console.cloud.google.com → APIs & Services → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=
# kick.com → Settings → Developer → Create app
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ── Phone pings ──
TZ=America/New_York
# hours (0-23) when ordinary pings wait; urgent ones still come. "off" for none
QUIET_HOURS=3-11
# smallest tip / Super Chat (in its own currency) and sub gift worth a ping
BIG_TIP=20
BIG_GIFT=10

# ── Weekly calendar ──
# Sunday hour (0-23, TZ) the new week's calendar is posted, and Saturday hour of the recap
CALENDAR_PREVIEW_HOUR=10
CALENDAR_RECAP_HOUR=23
# Leave empty: the Docker image brings its own Chromium for the calendar picture
CHROMIUM_PATH=

# ── Server care (role buttons, mod log, scam links, backups) ──
# Also turn on "Message Content Intent" and "Server Members Intent" in the developer portal
# (your app → Bot), and give the bot's role Manage Roles, Manage Messages, Timeout Members and
# View Audit Log. /setup check in Discord lists anything still missing.
# Timeout (minutes) for someone who posts a scam link; 0 = only delete it
SCAM_TIMEOUT_MIN=60
# Hour (0-23, TZ) of the daily backup of the server's channels, roles and permissions, and how many days to keep
BACKUP_HOUR=4
BACKUP_KEEP=30

# ── Server care round 2 (welcome, raid lockdown, warnings, modmail, live mode, starboard, moments) ──
# Also give the bot's role Manage Channels (slowmode, voice channel name) and Manage Server (pausing invites).
# A raid: this many joins within this many seconds switches lockdown on (/lockdown off undoes it)
RAID_JOINS=8
RAID_WINDOW_SEC=60
# /warn: every WARN_LIMIT-th warning within WARN_DAYS days = a timeout of WARN_TIMEOUT_MIN minutes (0 = no timeout)
WARN_LIMIT=3
WARN_DAYS=30
WARN_TIMEOUT_MIN=1440
# Hour (0-23, TZ) for anniversary and birthday posts, and Sunday's joins/leaves DM
MOMENTS_HOUR=10
